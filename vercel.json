{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": "api",
      "framework": "express",
      "entrypoint": "src/index.js",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "RUST_SERVER_URL"
        }
      ]
    },
    "app": {
      "root": ".",
      "runtime": "rust"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
