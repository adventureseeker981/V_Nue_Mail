# ============================================================================
# Encrypto Express Backend Environment Configuration
# ============================================================================

# Database configuration (PostgreSQL)
# For local development:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/v_nue_mail
# For production on Vercel (Neon, Supabase, Render, Railway, AWS RDS):
DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require

# Secret key used to sign and verify JWT authentication tokens (at least 32 characters)
JWT_SECRET=super-secret-jwt-key-for-private-mail-dev-environment

# Express Backend Port
PORT=3001

# Production frontend URL for CORS (defaults include https://encrypto-frontend-zeta.vercel.app)
FRONTEND_URL=https://encrypto-frontend-zeta.vercel.app

# Rust Mail Server URL (supports both RUST_SERVER_URL and RUST_MAIL_SERVER_URL)
RUST_SERVER_URL=https://encrypto-src.vercel.app
RUST_MAIL_SERVER_URL=https://encrypto-src.vercel.app
