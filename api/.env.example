# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/v_nue_mail
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=3001

# Production frontend URL for CORS (defaults include https://encrypto-frontend-zeta.vercel.app)
FRONTEND_URL=https://encrypto-frontend-zeta.vercel.app

# Optional Rust Mail Server URL (leave unset until Rust server is deployed)
# RUST_SERVER_URL=http://127.0.0.1:8080
